# Copia este archivo como .env y completa los valores. No subas ni compartas el .env.

# Postgres (obligatoria)
DATABASE_URL=
# Poner "require" si la base exige SSL (por ejemplo la URL pública de Railway)
PGSSL=

# Firma de las sesiones (obligatoria en producción): texto largo y aleatorio
SESSION_SECRET=

# Primer administrador (se crea solo si todavía no existe ningún usuario)
ADMIN_USER=
ADMIN_NAME=
ADMIN_PASSWORD=

# Servidor
PORT=
NODE_ENV=
TZ=

# Correo de alertas (opcional: sin esto las alertas se ven igual en la pantalla)
# Opción A: Brevo por HTTPS (si existe, se usa en vez de SMTP)
BREVO_API_KEY=
# Opción B: SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente, por ejemplo: "Flota NDM <correo@dominio.cl>"
MAIL_FROM=
# Destinatarios por defecto, separados por coma (después se cambian desde la pantalla)
ALERT_EMAIL=
# Cada cuántos minutos revisa las alertas (por defecto 60)
ALERT_CHECK_MINUTES=

# Solo para pruebas (npm test) y para probar el correo con un servidor falso
BASE=
BREVO_API_URL=
BREVO_SENDER=
