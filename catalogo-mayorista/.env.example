# --- Base de datos y sesiones ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/catalogo
PGSSL=            # "require" si tu Postgres lo pide
SESSION_SECRET=   # texto largo y aleatorio (obligatorio en producción)
ADMIN_EMAIL=ernesto@repuestosdelmaule.cl
ADMIN_PASSWORD=   # solo se usa para crear el primer administrador si no hay usuarios

# --- Bsale ---
BSALE_TOKEN=                       # access_token de la API de Bsale
BSALE_OFFICES=Talca,Bodega Adicional   # sucursales cuyo stock se suma (por nombre, separadas por coma)
BSALE_PRICE_LIST=Mayorista         # nombre (o parte del nombre) de la lista de precios; o BSALE_PRICE_LIST_ID=12
PRICE_MODE=iva                     # iva (precio con IVA incluido, por defecto) | neto
JUEGO_UNIDADES=4                   # solo informativo: llantas que trae cada juego (en Bsale la variante ya es el juego)
SYNC_MINUTES=15

# --- Nota de venta en Bsale (al confirmar el pedido el vendedor/a) ---
BSALE_NV=                          # "on" para crear la nota de venta al confirmar; vacío = solo confirma (no toca Bsale)
BSALE_NV_OFFICE=Talca              # sucursal que emite y descuenta el stock
BSALE_NV_DOCTYPE=Nota de venta     # nombre del tipo de documento (o BSALE_NV_DOCTYPE_ID=n)
                                   # el token de Bsale debe tener permiso para emitir documentos

# --- Google Drive (fotos por SKU) ---
DRIVE_FOLDER_ID=                   # carpeta de Drive con las fotos
GOOGLE_SERVICE_ACCOUNT_JSON=       # JSON completo de la cuenta de servicio (o en base64)

# --- Opcionales ---
EMPRESA=Repuestos del Maule
CACHE_DIR=./cache
PORT=3000
