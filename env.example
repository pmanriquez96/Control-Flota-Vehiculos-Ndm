# Copia este archivo como .env para trabajar en tu computador. En Railway se cargan como Variables.

# Conexión a Postgres (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://usuario:clave@localhost:5432/ndm

# Texto largo y aleatorio para firmar las sesiones (obligatorio en producción)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Primer administrador (se crea solo si todavía no existe ningún usuario)
ADMIN_USER=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambia-esta-clave

# Correo de alertas (se puede dejar vacío hasta tenerlo; las alertas se ven igual en la página)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flota NDM <correo@tu-dominio.cl>"
# Destinatario por defecto (después se cambia desde la pestaña Alertas de la página)
ALERT_EMAIL=

# Opcionales
# PGSSL=require        -> si usas la URL pública de Postgres de Railway
# ALERT_CHECK_MINUTES=60
# TZ=America/Santiago
